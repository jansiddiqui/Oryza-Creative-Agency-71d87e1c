# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are public (they end up in the browser). Never put secrets in them.

# Public site URL — canonical URLs, sitemap, schema. Canonical host is www (oryzaonline.in redirects to it).
NEXT_PUBLIC_SITE_URL=https://www.oryzaonline.in

# Contact details (defaults in src/lib/site.ts: +91 7007345134, contact@oryzaonline.in).
NEXT_PUBLIC_PHONE=+91 7007345134
NEXT_PUBLIC_EMAIL=contact@oryzaonline.in
# WhatsApp Business number, digits with country code (same as the phone).
NEXT_PUBLIC_WHATSAPP_NUMBER=917007345134
# TODO: street address, PIN code and hours. Hidden until set.
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_PIN=
NEXT_PUBLIC_HOURS=
# TODO: Oryza's own profile URLs. Hidden until set.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Lead delivery by email via Resend (https://resend.com). SECRET — server only.
RESEND_API_KEY=
# Defaults: leads to contact@oryzaonline.in, sent from website@oryzaonline.in (domain must be verified in Resend).
LEAD_TO_EMAIL=contact@oryzaonline.in
LEAD_FROM_EMAIL="Oryza Website <website@oryzaonline.in>"

# Analytics — each loads only when set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
# Search Console HTML-tag verification token (only the content="…" value). Optional if verified via DNS.
NEXT_PUBLIC_GSC_VERIFICATION=
